---
import { getEmDashEntry } from "emdash";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import ContentBody from "../components/ContentBody.astro";
const { entry } = await getEmDashEntry("pages", "about");
const data = entry?.data ?? { title: "About", description: "", body: "", body_format: "markdown" };
if (!entry) Astro.response.status = 404;
---
<BaseLayout title={data.title} description={data.description}>
  <PageBanner title={data.title} description={data.description} />
  <ContentBody body={data.body} bodyFormat={data.body_format} />
</BaseLayout>
