---
import "../styles/main.css";
import SeoHead from "../components/SeoHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  image?: unknown;
  tags?: unknown;
  type?: string;
}

const {
  title = "Matt Kevan",
  description = "Art, design & code.",
  image,
  type = "website",
} = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="classic-mono-scrollbars">
  <head>
    <SeoHead title={title} description={description} image={image} type={type} />
  </head>
  <body class="min-h-screen bg-white text-black @container">
    <main class="pb-24">
      <slot />
    </main>
    <SiteFooter />
    <SiteHeader currentPath={currentPath} />
    <script is:inline src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script is:inline data-goatcounter="https://unltddreamco.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>

  </body>
</html>

