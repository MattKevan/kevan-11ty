{
  "name": "kevan-tv",
  "version": "2.0.0",
  "private": true,
  "description": "Kevan.tv — art, design and code",
  "scripts": {
    "dev": "astro dev --config astro.config.local.mjs --host localhost --port 4322 --strictPort",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "emdash:types": "emdash types",
    "emdash:migrate": "node src/scripts/migrate-legacy-content.mjs",
    "emdash:seed": "npm run emdash:migrate && emdash seed .emdash/seed.json --database ./data.db --on-conflict update"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@emdash-cms/cloudflare": "^1.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "emdash": "^1.0.1",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "wrangler": "^4.44.0"
  },
  "allowScripts": {
    "workerd@1.20260926.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true
  }
}
